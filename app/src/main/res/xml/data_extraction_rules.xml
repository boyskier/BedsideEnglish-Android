<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="med_voice_encrypted_prefs.xml" />
        <!-- Keystore-unavailable fallback store (Repository.openPrefs): plaintext, never back it up. -->
        <exclude domain="sharedpref" path="med_voice_prefs_unencrypted.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="learner_audio/" />
    </cloud-backup>
    <device-transfer>
        <!-- Keystore ciphertext cannot safely be restored under a different device key. -->
        <exclude domain="sharedpref" path="med_voice_encrypted_prefs.xml" />
        <exclude domain="sharedpref" path="med_voice_prefs_unencrypted.xml" />
        <exclude domain="file" path="learner_audio/" />
    </device-transfer>
</data-extraction-rules>
