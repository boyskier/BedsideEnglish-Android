{
  "_note": "Deterministic history-taking domains shared by the phase bar, open-book checklist, Help me continue, and guided-script fallback. `phase` maps to the five-stage navigator (0 initiation, 1 HPI, 2 PMH, 3 medicines/allergies, 4 social/family/close). Flexible intent regexes live in app/analysis/interview_rules.py; `keywords` are additional high-precision learner phrases. `follow_cues` are negation-aware patient cues used only to rank a natural next question. No API or LLM calls are involved.",
  "domains": [
    {
      "key": "opening",
      "phase": 0,
      "core": true,
      "label": "Open the consultation",
      "keywords": ["brings you in", "how can i help", "what can i do for you", "tell me what happened", "tell me more about", "how are you feeling today"],
      "follow_cues": [],
      "questions": [
        "What brings you in today?",
        "How can I help you today?"
      ]
    },
    {
      "key": "onset_duration",
      "phase": 1,
      "core": true,
      "label": "Onset & duration",
      "keywords": ["when did", "how long", "since when", "when it started", "did it start", "first notice"],
      "follow_cues": ["started", "began", "recently", "this morning", "yesterday", "few days", "a week", "suddenly", "out of nowhere"],
      "questions": [
        "When did symptoms start?",
        "How long have you had this?"
      ]
    },
    {
      "key": "location",
      "phase": 1,
      "core": true,
      "label": "Location / site",
      "keywords": ["where exactly", "where do you feel", "where is the", "which part", "point to", "show me where"],
      "follow_cues": ["here", "right here", "in my", "on my", "around my", "my chest", "my stomach", "my head", "my back"],
      "questions": [
        "Where exactly do you feel it?",
        "Can you point to where it is?"
      ]
    },
    {
      "key": "radiation",
      "phase": 1,
      "core": false,
      "chief_terms": ["pain", "ache", "discomfort", "pressure", "tightness"],
      "label": "Radiation / spread",
      "keywords": ["radiate", "spread anywhere", "travel anywhere", "move anywhere", "go anywhere else"],
      "follow_cues": ["to my arm", "into my arm", "to my back", "to my jaw", "to my shoulder", "spreads", "travels"],
      "questions": [
        "Does it move or spread anywhere else?",
        "Does the pain travel to your arm, back, or jaw?"
      ]
    },
    {
      "key": "character",
      "phase": 1,
      "core": true,
      "label": "Character / quality",
      "keywords": ["describe", "what does it feel like", "what kind of", "sharp or dull", "feel like"],
      "follow_cues": ["pain", "ache", "aches", "hurts", "hurting", "sore", "uncomfortable", "discomfort", "pressure", "tight"],
      "questions": [
        "Can you describe what it feels like?",
        "What kind of pain is it — sharp, dull, burning?"
      ]
    },
    {
      "key": "severity",
      "phase": 1,
      "core": true,
      "label": "Severity (1–10)",
      "keywords": ["scale of", "out of ten", "out of 10", "how bad", "how severe", "1 to 10", "one to ten"],
      "follow_cues": ["really bad", "terrible", "unbearable", "so much", "can't stand", "worst", "killing me", "very painful"],
      "questions": [
        "On a scale of one to ten, how bad is it?",
        "How much does it affect your daily life?"
      ]
    },
    {
      "key": "aggravating",
      "phase": 1,
      "core": true,
      "label": "Aggravating factors",
      "keywords": ["make it worse", "makes it worse", "worse when", "what worsens", "trigger", "aggravate"],
      "follow_cues": ["when i move", "when i walk", "when i eat", "worse at night", "after eating", "exercise makes", "deep breath"],
      "questions": [
        "Does anything make it worse?",
        "Have you noticed anything that triggers it?"
      ]
    },
    {
      "key": "relieving",
      "phase": 1,
      "core": true,
      "label": "Relieving factors",
      "keywords": ["make it better", "makes it better", "anything help", "better when", "what relieves", "ease it"],
