      ]
    },
    {
      "key": "living_work",
      "phase": 4,
      "core": true,
      "label": "Home & occupation",
      "keywords": ["who do you live", "live alone", "live with", "your work", "your job", "occupation", "line of work", "what do you do for"],
      "follow_cues": ["i work", "my job", "i live", "my husband", "my wife", "my partner", "stress at work"],
      "questions": [
